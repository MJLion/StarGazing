{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      ".git/**",
      ".vscode/**",
      ".firebase/**",
      ".kiro/**",
      "functions/**",
      "firestore.rules",
      "firestore.indexes.json",
      "README.md",
      "**/*.log",
      "**/node_modules/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "stargazing-mockup-v3.html",
      "**/*.md",
      "**/*.pdf",
      "images/products/README.txt"
    ],
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|svg|webp|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
